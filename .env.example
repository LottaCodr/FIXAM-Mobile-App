# Copy to .env and fill in. Never commit real secrets.

# --- Supabase (Project Settings → API) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by Edge Functions / CI — never ship in the app binary
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Flutterwave (Dashboard → Settings → API keys) ---
# v3 secret key. Test keys start with FLWSECK_TEST-
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Dashboard → Settings → Webhooks → Secret hash
FLW_SECRET_HASH=replace-with-long-random-string
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
# test | live
FLW_ENV=test

# Public key is safe to expose; used only if you ever embed inline checkout
EXPO_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Deep link Flutterwave redirects to after checkout
EXPO_PUBLIC_PAYMENT_REDIRECT=fixam://payment/callback

# --- Social login (Supabase Auth → Providers) ---
# Also paste these into the Supabase dashboard. Redirect URL:
#   https://YOUR_PROJECT.supabase.co/auth/v1/callback
# Additional redirect: fixam://auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- SMS OTP (Supabase Auth → Hooks → Send SMS) ---
# Recommended for NG: Termii. Configure the hook URL to your function or
# enable Twilio/MessageBird in the dashboard.
TERMII_API_KEY=
TERMII_SENDER_ID=FixAm
